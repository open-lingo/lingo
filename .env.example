# Auth0 — same tenant as lingo-core/lingo-ops.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# lingo-core (user-facing FastAPI). Default matches the dev uvicorn line.
VITE_API_BASE_URL=http://localhost:8000

# lingo-ops (admin dashboard API). Runs on a different port from lingo-core
# so the two services can dev side-by-side without port conflicts. The
# admin operations page (/admin/operations) talks to this base URL.
VITE_OPS_API_BASE_URL=http://localhost:8001

# Origin static audio is fetched from — TTS mp3s live at
# <base>/tts/v1/<lang>/<hash16>.mp3.
#
# LEAVE THIS EMPTY for web. The committed `.env` does not set it and neither
# does `.github/workflows/deploy.yml`, so both dev and prod resolve clips
# same-origin, which is correct: CloudFront fronts the app and /tts/* together.
# (This comment claimed `.env` already set it to "the public CDN". It does not,
# and the value below was the MARKETING origin — see the warning.)
#
# ⚠️ If you do set it, it must be `https://app.openlingoapp.com`. The bare
# apex `https://openlingoapp.com` serves the marketing site, which answers
# every /tts/ path with its 29 KB SPA shell at **HTTP 200 and
# content-type: text/html** — not a 404. `decodeAudioData` then rejects the
# HTML and the clip goes silent with only a console.warn. Measured 2026-08-07;
# it was the actual cause of "no audio on the iPhone build".
VITE_ASSET_BASE_URL=
