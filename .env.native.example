# Native (iOS) build env — copy to `.env.native` and fill in.
#
# `npm run build:native` loads this via `vite build --mode native`, so it
# OVERRIDES the committed `.env` (which points at localhost). A native bundle
# built without it ships a webview that talks to 127.0.0.1 and an Auth0
# redirect that can never come back into the app.
#
# `.env.native` is gitignored — it holds the same values as the GitHub repo
# variables on the deploy workflow, which are not secrets, but there's no
# reason to duplicate them into git.

# Flips every native branch on. Nothing else sets this.
VITE_NATIVE=true

# ── Backend ────────────────────────────────────────────────────────────────
# Must be the deployed lingo-core Lambda URL, NOT localhost — a phone has no
# access to your Mac's loopback. Same value as the `VITE_API_BASE_URL` repo
# variable used by .github/workflows/deploy.yml.
VITE_API_BASE_URL=https://zvtnaex5hp2y6lxv7gqqxu5zge0jhiea.lambda-url.us-west-1.on.aws

# ── Auth0 ──────────────────────────────────────────────────────────────────
# ⚠️ Use a SEPARATE Auth0 application of type "Native", not the SPA app the
# web build uses. A native client needs the custom-scheme callback added to
# its Allowed Callback URLs / Allowed Logout URLs, and adding those to the
# live SPA application would be editing production auth config to ship a test
# build. A second app costs nothing and keeps the blast radius at zero.
#
# In the new Native application, set BOTH lists to:
#   com.openlingo.app://dev-txjdn01ew3dmaecy.us.auth0.com/capacitor/com.openlingo.app/callback
# and enable the Refresh Token grant (Application → Settings → Advanced →
# Grant Types → Refresh Token). Without it every cold launch logs the user out:
# WKWebView's ITP blocks the silent-auth iframe Auth0 would otherwise use.
VITE_AUTH0_DOMAIN=dev-txjdn01ew3dmaecy.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=openlingodev

# ── Marketing origin ───────────────────────────────────────────────────────
# Only reached now by footer `<a href>` links (Capacitor opens off-origin
# navigations in the system browser, which is the behaviour we want there).
# The anonymous-user redirect no longer uses it on native — see
# `routes/MarketingRedirect.tsx`.
VITE_MARKETING_ORIGIN=https://openlingoapp.com

# ── Audio ──────────────────────────────────────────────────────────────────
# REQUIRED on native, unlike web.
#
# The web app leaves this empty and resolves TTS clips SAME-ORIGIN (`assetUrl`
# returns a relative path) because CloudFront fronts both the app and /tts/*.
# In a Capacitor app the bundle is served from `capacitor://localhost`, so a
# relative `/tts/...` resolves into the app bundle, where no mp3s exist.
#
# An absolute base is only half the fix: playback is `fetch` +
# `decodeAudioData`, which IS CORS-enforced, and the bucket sends no
# Access-Control-Allow-Origin. The other half is `shared/platform/nativeHttp.ts`,
# which routes that one fetch through the native HTTP stack (no origin, no
# preflight). Both are needed — this variable without that code is silence.
VITE_ASSET_BASE_URL=https://openlingoapp.com

# ── Auth bypass ────────────────────────────────────────────────────────────
# Runs the app as a fake signed-in user so hardware testing (layout under the
# notch, the lesson player on a real screen) doesn't block on somebody creating
# an Auth0 Native application. SRS is local-first, so lessons and flashcards
# work; server sync does NOT.
#
# ⚠️ This TEMPLATE ships it off, deliberately. Flip it to "true" in your own
# `.env.native` only while you need it, and set it back — a bypassed build has
# no valid token, so anything server-shaped fails in a way that looks like a
# backend bug. It is fenced by `IS_NATIVE` so it can never affect a web build,
# and a bypassed app paints a permanent red "NO AUTH" badge, but neither is a
# reason to default it on in a file everyone copies.
# See `src/shared/auth/bypass.ts`.
VITE_NATIVE_AUTH_BYPASS=false
