true,"kind":"particle","hint":"lay — one article for every plural, both sides"},{"id":"fr:des","languageId":"fr","surface":"des","gloss":"some (plural)","partOfSpeech":"particle","fromModule":"m10","srsEligible":true,"kind":"particle","hint":"day — the plural 'a'; un and une's big sibling"},{"id":"fr:chats","languageId":"fr","surface":"chats","gloss":"cats","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"shah — the -s is silent; «les» does the talking","gender":"m","homophoneKey":"ʃa"},{"id":"fr:chiens","languageId":"fr","surface":"chiens","gloss":"dogs","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"shyan — same sound as one dog","gender":"m","homophoneKey":"ʃjɛ̃"},{"id":"fr:livres","languageId":"fr","surface":"livres","gloss":"books","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"LEE-vruh — the plural hides in the article","gender":"m","homophoneKey":"livʁ"},{"id":"fr:croissants","languageId":"fr","surface":"croissants","gloss":"croissants","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"krwa-SAHN — order two, hear no -s","gender":"m","homophoneKey":"kʁwasɑ̃"},{"id":"fr:écoles","languageId":"fr","surface":"écoles","gloss":"schools","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"ay-KOHL — but «les écoles» hides a z between the words","gender":"f","homophoneKey":"ekɔl"},{"id":"fr:hôtels","languageId":"fr","surface":"hôtels","gloss":"hotels","partOfSpeech":"noun","fromModule":"m10","srsEligible":true,"kind":"vocab","hint":"oh-TELL — the z links through the silent h","gender":"m","homophoneKey":"otɛl"},{"id":"fr:aime","languageId":"fr","surface":"aime","gloss":"loves/likes (il/elle/on)","partOfSpeech":"verb","fromModule":"m11","srsEligible":true,"kind":"vocab","hint":"the same sound as j'aime — the -e is silent","homophoneKey":"ɛm"},{"id":"fr:aimes","languageId":"fr","surface":"aimes","gloss":