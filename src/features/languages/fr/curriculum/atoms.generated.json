lent","gender":"m","homophoneKey":"øʁo"},{"id":"fr:ça coûte","languageId":"fr","surface":"ça coûte","gloss":"it costs","partOfSpeech":"verb","fromModule":"m12","srsEligible":true,"kind":"phrase","hint":"sa koot — frozen, like «c'est»; never conjugated by subject here"},{"id":"fr:c'est cher","languageId":"fr","surface":"c'est cher","gloss":"it's expensive","partOfSpeech":"adjective","fromModule":"m12","srsEligible":true,"kind":"phrase","emoji":"💸","hint":"say shair"},{"id":"fr:ce n'est pas cher","languageId":"fr","surface":"ce n'est pas cher","gloss":"it's not expensive / it's cheap","partOfSpeech":"adjective","fromModule":"m12","srsEligible":true,"kind":"phrase","hint":"suh nay pa shair — full «ne…pas», same shape as m2's «je ne comprends pas»"},{"id":"fr:je sais","languageId":"fr","surface":"je sais","gloss":"I know","partOfSpeech":"verb","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"zhuh say — «savoir», chunked for now"},{"id":"fr:tu sais","languageId":"fr","surface":"tu sais","gloss":"you know","partOfSpeech":"verb","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"tu say — the -s is silent, as ever"},{"id":"fr:je ne sais pas","languageId":"fr","surface":"je ne sais pas","gloss":"I don't know","partOfSpeech":"verb","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"zhuh nuh say pa — the full WRITTEN form; canonical answer everywhere"},{"id":"fr:je sais pas","languageId":"fr","surface":"je sais pas","gloss":"I don't know (spoken)","partOfSpeech":"verb","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"zhuh say pa — casual speech drops the «ne»; never write this as an answer"},{"id":"fr:pourquoi ?","languageId":"fr","surface":"pourquoi ?","gloss":"why?","partOfSpeech":"other","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"poor-KWA"},{"id":"fr:parce que","languageId":"fr","surface":"parce que","gloss":"because","partOfSpeech":"conjunction","fromModule":"m13","srsEligible":true,"kind":"phrase","hint":"