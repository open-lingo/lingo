  "grammarPoints": [
    {
      "id": "te-form",
      "rule": "The て-form is the verb's CONNECTOR. る-verbs just swap る for て: たべる → たべて. う-verbs follow a sound-change table by their last kana: む/ぶ/ぬ → んで (のむ → のんで); う/つ/る → って (かう → かって); く → いて (きく → きいて); ぐ → いで. する → して, くる → きて. いく is the one rebel: いって, not いいて.",
      "examples": [
        {
          "ja": "たべて",
          "en": "eat (て-form)"
        },
        {
          "ja": "のんで",
          "en": "drink (て-form)"
        }
      ],
      "antiPattern": {
        "ja": "のみて",
        "en": "",
        "why": "のむ is an う-verb ending in む — it becomes のんで, not のみて"
      }
    },
    {
      "id": "te-kudasai",
      "rule": "て + ください = a polite request: 'please do X'. It is a fixed FORMULA — you attach ください to the て-form and nothing else changes. Drop ください and the bare て-form is the casual version friends use: みて = 'look', みてください = 'please look'.",
      "examples": [
        {
          "ja": "みてください",
          "en": "Please look."
        },
        {
          "ja": "たべてください",
          "en": "Please eat."
        }
      ],
      "antiPattern": {
        "ja": "たべるください",
        "en": "",
        "why": "ください attaches to the て-form, not the dictionary form — たべてください"
      }
    }
  ],
