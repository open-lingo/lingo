  "grammarPoints": [
    {
      "id": "numbers-1-10",
      "rule": "いち に さん よん ご ろく なな はち きゅう じゅう. Four and seven have two readings each — よん/し and なな/しち. Use よん and なな: they are the ones that never collide with anything, and native speakers reach for them first when counting things.",
      "examples": [
        {
          "ja": "いち に さん",
          "en": "one, two, three"
        },
        {
          "ja": "よん ご ろく",
          "en": "four, five, six"
        }
      ]
    },
    {
      "id": "counter-tsu",
      "rule": "〜つ is the ALL-PURPOSE counter for things: ひとつ ふたつ みっつ よっつ いつつ. It works for objects when you don't know the specific counter, which as a beginner is most of the time. It stops at とお (10) — past that you use the plain numbers.",
      "examples": [
        {
          "ja": "ひとつ ください",
          "en": "One, please."
        },
        {
          "ja": "ふたつ ある",
          "en": "There are two."
        }
      ],
      "antiPattern": {
        "ja": "いちつ",
        "en": "",
        "why": "the 〜つ series uses its own readings — ひとつ, not いちつ"
      }
    },
    {
      "id": "ikura-price",
      "rule": "いくら asks the price: いくらですか = 'how much is it?'. The answer is a number + えん. Prices are the one place a beginner needs numbers immediately, so this is where the number line gets spent.",
      "examples": [
        {
          "ja": "いくらですか",
          "en": "How much is it?"
        },
        {
          "ja": "ひゃくえんです",
          "en": "It's a hundred yen."
        }
      ]
    }
  ],
