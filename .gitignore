# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
# No trailing slash: also ignores a `node_modules` SYMLINK (as git-worktree
# setups create), which `node_modules/` (directory-only) would let `git add -A`
# stage and commit — that symlink then shadows the real install on merge.
node_modules
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
# `!.env.example` is an exact match, so the native template needs its own
# negation or `.env.*` swallows it. `.env.native` itself stays ignored.
!.env.native.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local-only working notes (not for the repo)
japanese_tutor_handoff.md

# Playwright
.auth/
test-results/
playwright-report/
playwright/.cache/

# Windows file zone metadata (created by WSL on copied-in files)
*:Zone.Identifier

# Misplaced VSCode workspace file (the real one lives at repo root)
src/shared/domain/lingo.code-workspace

# Generated TTS audio. The mp3s are published by the lingo-data pipeline to
# the CDN under tts/v1/<lang>/<hash16>.mp3 and fetched from VITE_ASSET_BASE_URL
# at runtime; a local regeneration run must never re-land 240 MB in the repo.
# The per-language manifests the app reads live in src/shared/tts/manifests/.
src/pub/tts/

# Auto-copied kuromoji dictionary files (see vite.config.ts copyKuromojiDict).
# Mirrored from node_modules/kuromoji/dict on each build; never hand-edit.
src/pub/dict/

# Claude Code config — share project skills, keep local settings out
.claude/*
!.claude/skills/
.superpowers/

# Agent/worktree screenshot artifacts (never commit)
.screenshots/
.worktree-shots/

# YouTube transcript working material (pedagogy recon) — internal study only, not shipped
research/
scripts/__pycache__/

# Visual-QA gate artifacts (contracts + screenshots, regenerated per run)
artifacts/

# mobile render pipeline screenshot output
mobile-shots*/

# downloaded raw gov corpus (reproducible via scripts/data/ko-frequency-raw/SOURCES.txt)
scripts/data/ko-frequency-raw/

# Dev-only TTS clip cache (see serveTtsLocally in vite.config.ts). Populated
# on demand from the CDN so local dev works offline after first use.
.tts-cache/

# Capacitor iOS wrapper. The Xcode project IS committed (it carries the bundle
# id, the `com.openlingo.app://` URL scheme and the Info.plist usage strings).
# The generated parts are excluded by `ios/.gitignore`, which Capacitor writes
# and maintains — notably `App/App/public`, a straight copy of `dist/` from
# `cap sync` that would otherwise double every asset in the repo. Deliberately
# NOT duplicated here: two copies of the same rules drift, and the one next to
# the files is the one `cap add` will keep current.

# Local-model drafting output — generated, oversampled, and unverified.
# These are INPUT to a verification pass, never content. Regenerate with
# scripts/draft/batch-es.mjs rather than committing a snapshot.
scripts/draft/drafts/
.tsbuildinfo-gate
