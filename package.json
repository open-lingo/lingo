{
  "name": "open-lingo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:live": "vite --mode live --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test --project='auth setup' --headed",
    "visual-qa:contracts": "vitest run src/features/lesson/dev/visualQaContracts.emit.test.ts",
    "visual-qa:capture": "playwright test visual-qa-capture --project=chromium",
    "module-gate": "node scripts/module-gate.mjs",
    "test:mobile": "playwright test --project=mobile",
    "test:mobile:shots": "node scripts/mobile-matrix.mjs",
    "test:mobile:snap": "playwright test --project=mobile --grep @snapshot --pass-with-no-tests",
    "test:mobile:update": "playwright test --project=mobile --grep @snapshot --update-snapshots --pass-with-no-tests"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.15.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.62.0",
    "@uiw/react-md-editor": "^4.0.11",
    "i18next": "^25.8.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "lucide-react": "^0.575.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.1",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "ts-fsrs": "^5.4.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.6"
  }
}
