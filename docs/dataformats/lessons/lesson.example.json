      "type": "listening_comprehension",
      "audioKey": "audio/ko/dialogue-greeting-01.mp3",
      "transcript": "A: 안녕하세요! B: 안녕하세요! 잘 지내세요?",
      "question": "What does person B ask after greeting?",
      "options": [
        { "id": "a", "text": "Where are you going?" },
